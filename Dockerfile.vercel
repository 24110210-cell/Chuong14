FROM tomcat:10.1-jdk21-openjdk-slim

# Xóa ứng dụng mặc định của Tomcat
RUN rm -rf /usr/local/tomcat/webapps/*

# Copy file WAR vào webapps
COPY dist/Bai13_1.war /usr/local/tomcat/webapps/ROOT.war

# Entrypoint tự động sửa cổng Tomcat theo $PORT lúc RUNTIME
# (Vercel inject PORT=80 khi container khởi động)
RUN printf '#!/bin/sh\n\
sed -i "s/port=\\"8080\\"/port=\\"${PORT:-8080}\\"/" /usr/local/tomcat/conf/server.xml\n\
exec catalina.sh run\n' > /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]